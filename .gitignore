# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (all levels)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
coverage/

# next.js, bundlers & production builds (all levels)
.next/
out/
build/
dist/

# cloudflare workers / wrangler
.wrangler/
.dev.vars
.dev.vars.*

# cache & temporary files
.cache/
tmp/
temp/

# logs (all levels)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables & secrets (preserve example files)
.env
.env.*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS & misc files
.DS_Store
Thumbs.db
*.pem
