{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agendador-operational-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "queues": {
    "producers": [
      {
        "queue": "agendador-publish-queue",
        "binding": "PUBLISH_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "agendador-publish-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "agendador-publish-dlq",
        "max_concurrency": 5
      }
    ]
  }
}
