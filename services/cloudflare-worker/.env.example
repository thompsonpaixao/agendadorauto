# ==============================================================================
# Variáveis de Ambiente e Secrets - Cloudflare Workers
# Configuradas via 'wrangler secret put <NOME>' ou painel Cloudflare
# ==============================================================================

# Supabase (Banco de dados e Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...
SUPABASE_ANON_KEY=eyJh...

# Cofre Criptográfico (Obrigatório para descriptografar tokens da Meta)
TOKEN_ENCRYPTION_KEY=sua-chave-secreta-hex-ou-string-de-32-bytes

# Cloudflare R2 (Armazenamento Privado)
R2_ACCOUNT_ID=seu-cloudflare-account-id
R2_ACCESS_KEY_ID=seu-r2-access-key-id
R2_SECRET_ACCESS_KEY=seu-r2-secret-access-key
R2_BUCKET_NAME=agendador-media
R2_REGION=auto
R2_READ_URL_TTL_SECONDS=7200

# Meta Graph API
META_GRAPH_VERSION=v21.0
MAX_PROCESSING_TIMEOUT_MINUTES=20

# Configurações Operacionais
FEEDER_WINDOW_MINUTES=30
GLOBAL_CONCURRENCY=5
