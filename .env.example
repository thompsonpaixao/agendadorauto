# ==============================================================================
# SUPABASE AUTH & DATABASE CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-aqui
# Fallback de compatibilidade legado (opcional):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Allowlist de Acesso (emails autorizados durante desenvolvimento, separados por vírgula)
ALLOWED_EMAILS=usuario@exemplo.com,admin@agendador.com
NEXT_PUBLIC_ALLOWED_EMAILS=usuario@exemplo.com,admin@agendador.com

# ==============================================================================
# META INSTAGRAM API (INSTAGRAM LOGIN WITH INSTAGRAM API)
# ==============================================================================
# Para obter essas credenciais, crie um aplicativo no Meta for Developers
# e adicione o produto Instagram com permissões instagram_business_basic e instagram_business_content_publish
# https://developers.facebook.com/

# ID do Aplicativo Meta
META_APP_ID=

# Chave Secreta do Aplicativo Meta (NUNCA expor no frontend)
META_APP_SECRET=

# URI de Redirecionamento OAuth (deve estar cadastrada exatamente igual no Meta for Developers)
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

